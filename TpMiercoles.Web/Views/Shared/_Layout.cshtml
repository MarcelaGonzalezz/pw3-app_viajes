<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TpMiercoles.Web</title>
    <script type="importmap"></script>
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/sidebar/sidebar.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/TpMiercoles.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <partial name="_Sidebar" />        
        }

        <div class="app-main">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <header class="app-anon-header">
                    <a class="app-brand" asp-controller="Home" asp-action="Index">RuteaYa</a>
                    <a class="app-login-link" asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
                </header>
            }
            
            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

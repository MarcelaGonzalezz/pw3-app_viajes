@model NuevoEnvioViewModel
@using TpMiercoles.Entidades
@{
    ViewData["Title"] = "Nuevo envío";
}
<h1 class="h3 mb-0">Nuevo envío</h1>
<small class="text-muted">Publicá un paquete que necesita ser transportado.</small>

<form asp-action="Nuevo" method="post" class="card card-body mt-3">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Origen" class="form-label">Origen</label>
            <input asp-for="Origen" class="form-control" placeholder="¿Dónde lo retiran?" />
            <span asp-validation-for="Origen" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Destino" class="form-label">Destino</label>
            <input asp-for="Destino" class="form-control" placeholder="¿A dónde llega?" />
            <span asp-validation-for="Destino" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Fecha" class="form-label">Fecha</label>
            <input asp-for="Fecha" class="form-control" />
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PesoKg" class="form-label">Peso (kg)</label>
            <input asp-for="PesoKg" class="form-control" />
            <span asp-validation-for="PesoKg" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Monto" class="form-label">Monto ofrecido ($)</label>
            <input asp-for="Monto" class="form-control" />
            <span asp-validation-for="Monto" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Tamanio" class="form-label">Tamaño</label>
            <select asp-for="Tamanio" asp-items="ViewBag.Tamanios" class="form-select">
                <option value="">Seleccioná...</option>
            </select>
            <span asp-validation-for="Tamanio" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <input asp-for="Descripcion" class="form-control" placeholder="Ej: zapatillas, documentos" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-dark">Publicar envío</button>
    </div>
</form>
@model DashboardViewModel
@using System.Globalization
@using TpMiercoles.Entidades
@{
    ViewData["Title"] = "Home";
    var pesos = new CultureInfo("es-AR");
}
@section Styles {
    <link rel="stylesheet" href="~/css/viajes/detalle.css" asp-append-version="true" />
}
@if (TempData["Mensaje"] is string mensaje) {
    <div class="alert alert-success">@mensaje</div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-0">Hola, @Model.NombreUsuario</h1>
        <small class="text-muted">Esto pasa con tus viajes y envíos.</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Envio" asp-action="Nuevo" class="btn btn-outline-dark">Nuevo envío</a>     
         <a asp-controller="Ruta" asp-action="Crear" class="btn btn-dark">Nueva ruta</a>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a asp-controller="Viajes" asp-action="Index" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <small class="text-muted">Próximos viajes</small>
                <div class="fs-3 fw-bold">@Model.ProximosViajes</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Envio" asp-action="Index" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <small class="text-muted">Envíos pendientes</small>
                <div class="fs-3 fw-bold">@Model.EnviosPendientes</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted">Oportunidades</small>
                <div class="fs-3 fw-bold">@Model.Oportunidades</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Ganancias" asp-action="Index" class="card h-100 bg-success-subtle text-decoration-none text-reset">
            <div class="card-body">
                <small class="text-success">Potencial del mes</small>
                <div class="fs-3 fw-bold text-success">@(Model.PotencialMes?.ToString("C0", pesos) ?? "—")</div>
                <small class="text-muted">
                    @(Model.PotencialMes is null ? "No se pudo calcular ahora" : "Con mayor ganancia, sin límite de desvío")
                </small>
            </div>
        </a>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">Próximos viajes</h2>
                    <a asp-controller="Viajes" asp-action="Index" class="small text-decoration-none">Ver mis viajes</a>
                </div>
                @if (Model.ProximosViajesLista.Count == 0)
{
    <p class="text-muted mb-0">No tenés próximos viajes programados.</p>
}
else
{
    <div class="list-group list-group-flush">
        @foreach (var viaje in Model.ProximosViajesLista)
        {
            <a asp-controller="Viajes" asp-action="Detalle" asp-route-id="@viaje.Id"
               class="list-group-item list-group-item-action px-0 py-2 border-0 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-truncate me-2">
                        <div class="fw-semibold text-truncate">@viaje.DireccionOrigen &rarr; @viaje.DireccionDestino</div>
                        <small class="text-muted">Salida: @viaje.FechaSalida.ToString("dd/MM/yyyy HH:mm") &bull; @viaje.CantidadPaquetes/@viaje.CapacidadMaxPaquetes paquetes</small>
                    </div>
                </div>
            </a>
        }
    </div>
}
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">Envíos pendientes</h2>
                    <a asp-controller="Oportunidades" asp-action="Index" class="small text-decoration-none">Ver oportunidades</a>
                </div>
                @if (Model.EnviosPendientesLista.Count == 0)
                {
                    <p class="text-muted mb-0">Todavía no publicaste envíos pendientes.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var envio in Model.EnviosPendientesLista)
                        {
                            var badgeClase = envio.Estado switch
                            {
                                EstadoEnvio.BuscandoConductor => "vd-chip--asignado",
                                EstadoEnvio.ConductorAsignado => "vd-chip--asignado",
                                EstadoEnvio.Retirado => "vd-chip--retirado",
                                EstadoEnvio.EnCamino => "vd-chip--encamino",
                                EstadoEnvio.Entregado => "vd-chip--confirmado",
                                EstadoEnvio.Cancelado => "vd-chip--cancelado",
                                _ => "vd-chip--pendiente"
                            };

                            <a asp-controller="Envio" asp-action="Detalle" asp-route-id="@envio.Id"
                               class="list-group-item list-group-item-action px-0 py-2 border-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="text-truncate me-2">
                                        <div class="fw-semibold text-truncate">@envio.Origen &rarr; @envio.Destino</div>
                                        <small class="text-muted">Entrega hasta: @envio.FechaHasta.ToString("dd/MM/yyyy") &bull; @envio.TamanioTexto</small>
                                    </div>
                                    <span class="vd-chip @badgeClase">@envio.EstadoTexto</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Home";
    var pesos = new CultureInfo("es-AR");
}
@if (TempData["Mensaje"] is string mensaje) {
    <div class="alert alert-success">@mensaje</div>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-0">Hola, @Model.NombreUsuario</h1>
        <small class="text-muted">Esto pasa con tus viajes y envíos.</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Envio" asp-action="Nuevo" class="btn btn-outline-dark">Nuevo envío</a>     
        <a href="#" class="btn btn-dark">Nuevo viaje</a>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a asp-controller="Viajes" asp-action="Index" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <small class="text-muted">Próximos viajes</small>
                <div class="fs-3 fw-bold">@Model.ProximosViajes</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Envio" asp-action="Index" class="card h-100 text-decoration-none text-reset">
            <div class="card-body">
                <small class="text-muted">Envíos pendientes</small>
                <div class="fs-3 fw-bold">@Model.EnviosPendientes</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <small class="text-muted">Oportunidades</small>
                <div class="fs-3 fw-bold">@Model.Oportunidades</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 bg-success-subtle">
            <div class="card-body">
                <small class="text-success">Potencial del mes</small>
                <div class="fs-3 fw-bold text-success">@Model.PotencialMes.ToString("C0", pesos)</div>
            </div>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">Próximos viajes</h2>
                    <a asp-controller="Viajes" asp-action="Index" class="small text-decoration-none">Ver mis viajes</a>
                </div>
                <p class="text-muted mb-0">Todavía no registraste viajes.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">Envíos pendientes</h2>
                    <a asp-controller="Envio" asp-action="Index" class="small text-decoration-none">Ver mis envíos</a>
                </div>
                <p class="text-muted mb-0">Todavía no publicaste envíos.</p>
            </div>
        </div>
    </div>
</div>

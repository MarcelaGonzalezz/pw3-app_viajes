@model RegistroUsuarioViewModel
@{
    Layout = null;
    ViewData["Title"] = "Registrarse";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TpMiercoles.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TpMiercoles.Web.styles.css" asp-append-version="true" />
    <partial name="_AvatarStyles" />
</head>
<body>
    <div class="login-page">
        <form class="login-form login-form--registro" asp-controller="Usuario" asp-action="Registrar" method="post">

            <partial name="_AvatarSvg" />
            <h1 class="login-title">Creá a tu cuenta</h1>
            <div class="form-grid">

                <div class="input-group">
                    <label for="registroNombre">Nombre</label>
                    <input asp-for="Nombre" type="text" id="registroNombre" class="input-plain" autocomplete="given-name" />
                    <span asp-validation-for="Nombre" class="error"></span>
                </div>

                <div class="input-group">
                    <label for="registroApellido">Apellido</label>
                    <input asp-for="Apellido" type="text" id="registroApellido" class="input-plain" autocomplete="family-name" />
                    <span asp-validation-for="Apellido" class="error"></span>
                </div>

                <div class="input-group input-group--full">
                    <label for="loginEmail">Email</label>
                    <input asp-for="Email" type="email" id="loginEmail" class="input-email" maxlength="254"
                           placeholder=" " autocomplete="email" data-avatar-email />
                    <p class="helper">email@@domain.com</p>
                    <span asp-validation-for="Email" class="error"></span>
                </div>

               <div class="input-group input-group--password">
    <label for="registroPassword">Contraseña</label>
    <div class="password-field">
        <input asp-for="Contrasenia" type="password" id="registroPassword" autocomplete="new-password" data-avatar-password />
        <button type="button" class="toggle-eye" aria-label="Mostrar contraseña" aria-pressed="false">
            <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z" />
                <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z" />
                <circle cx="12" cy="12" r="3" />
                <path d="M3 3l18 18" />
            </svg>
        </button>
    </div>
    <span asp-validation-for="Contrasenia" class="error"></span>

    <!-- checkbox oculto: lo usa el script del avatar -->
    <input type="checkbox" id="showPasswordCheck" class="toggle-hidden" data-avatar-toggle tabindex="-1" aria-hidden="true" />
    <span asp-validation-for="RepetirContrasenia" class="error"></span>
</div>


<div class="input-group input-group--password">
    <label for="registroConfirmar">Confirmar contraseña</label>
    <div class="password-field">
        <input asp-for="RepetirContrasenia" type="password" id="registroConfirmar" autocomplete="new-password" data-avatar-password />
        <button type="button" class="toggle-eye" aria-label="Mostrar contraseña" aria-pressed="false">
            <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z" />
                <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z" />
                <circle cx="12" cy="12" r="3" />
                <path d="M3 3l18 18" />
            </svg>
        </button>
    </div>
    <span asp-validation-for="RepetirContrasenia" class="error"></span>
</div>

                <div class="input-group input-group--full">
                    <button type="submit">Registrarse</button>
                </div>

            </div>
            <p class="register-link">
    ¿Ya tenés cuenta?
    <a asp-controller="Usuario" asp-action="Login">Iniciá Sesión</a>
</p>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_AvatarScripts" />
</body>
</html>
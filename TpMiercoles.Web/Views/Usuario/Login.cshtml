@model LoginUsuarioViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

@section Styles { <partial name="_AvatarStyles" /> }
<div class="login-page">
    <form class="login-form" asp-controller="Usuario" asp-action="Login" method="post">

<partial name="_AvatarSvg" />

<div class="input-group">
            <label for="loginEmail">Email</label>
            <input asp-for="Email" type="email" id="loginEmail" class="input-email" maxlength="254"
                   placeholder=" " autocomplete="email" data-avatar-email />
            <p class="helper">email@@domain.com</p>
        </div>

        <div class="input-group input-group--password">
            <label for="loginPassword">Contraseña</label>
            <input asp-for="Contrasenia" type="password" id="loginPassword" autocomplete="current-password" data-avatar-password />
            <label class="show-password" for="showPasswordCheck">
                Mostrar
                <input asp-for="Recordarme" type="checkbox" id="showPasswordCheck" data-avatar-toggle />
                <span class="indicator"></span>
            </label>
        </div>

        <div class="input-group">
            <button type="submit">Iniciar sesión</button>
        </div>
    </form>
    </div>
</div>



@section Scripts { <partial name="_AvatarScripts" /> }
